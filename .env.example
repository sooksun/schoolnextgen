# ─── Database ────────────────────────────────────────────────
# MySQL 8.0.30 via Laragon. Default Laragon user is root with no password.
DATABASE_URL="mysql://root:@localhost:3306/school_agent_db"

# ─── Auth ────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-32-plus-hex-chars-from-openssl-rand"
SESSION_COOKIE_NAME="snx_session"

# ─── Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Storage / Uploads ───────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="100"

# ─── App ─────────────────────────────────────────────────────
NODE_ENV="development"
PUBLIC_APP_URL="http://localhost:3000"

# ─── Cron / background jobs (optional) ────────────────────────
# CRON_ENABLED="true" starts in-process schedulers (node-cron). Default off
# in dev/test; turn on in production single-container docker. Disable for
# multi-replica deploys — use external cron + /api/cron/[job] instead.
# CRON_ENABLED="true"
# Required to call POST /api/cron/[job] from external scheduler:
# CRON_SECRET="<openssl rand -hex 24>"

# ─── Email (Resend — optional, leave blank for dry-run mode) ─
# Sign up at https://resend.com (free tier 100/day, 3000/month).
# Missing RESEND_API_KEY = dry-run (cron logs "would send to X" but doesn't).
# RESEND_API_KEY="re_..."
# EMAIL_FROM must be a verified domain. For pilot without a verified domain,
# Resend provides 'onboarding@resend.dev' as a sandbox (default below).
# EMAIL_FROM="SchoolNextgen <reminders@your.domain>"

# ─── Sentry (optional — leave blank to disable) ──────────────
# Server-side errors:
# SENTRY_DSN="https://<key>@<project>.ingest.sentry.io/<id>"
# Client-side errors (must be NEXT_PUBLIC_ to reach the browser):
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@<project>.ingest.sentry.io/<id>"
# Used for grouping / filtering in Sentry UI:
# SENTRY_ENVIRONMENT="pilot"
# Performance sampling (0.0 - 1.0). 0.1 = 10% of requests traced.
# SENTRY_TRACES_SAMPLE_RATE="0.1"
