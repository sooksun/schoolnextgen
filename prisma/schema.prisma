// SchoolNextgen — Prisma schema (Phase 1: Reflection-First MVP)
// Conventions:
//   - PascalCase models, snake_case tables via @@map
//   - CHAR(36) UUIDs generated in-app via @default(uuid())
//   - VARCHAR statuses (no enum) — validated with Zod in app layer
//   - All operational tables carry scope columns
//   - utf8mb4 charset enforced at DB level (MySQL 8 default is fine)

generator client {
  provider      = "prisma-client-js"
  // native = the host platform for `pnpm dev` / `pnpm test` (Windows on Laragon).
  // linux-musl-openssl-3.0.x = Alpine in the Docker runner image.
  // linux-musl-arm64-openssl-3.0.x = ARM (Raspberry Pi / Apple Silicon Linux).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Identity
// ============================================================

model Person {
  id             String   @id @default(uuid()) @db.Char(36)
  nationalIdHash String?  @map("national_id_hash") @db.VarChar(255)
  displayName    String   @map("display_name") @db.VarChar(255)
  firstName      String?  @map("first_name") @db.VarChar(255)
  lastName       String?  @map("last_name") @db.VarChar(255)
  email          String?  @db.VarChar(255)
  phone          String?  @db.VarChar(50)
  profile        Json?
  status         String   @default("active") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  users             User[]
  schoolMemberships UserSchoolMembership[]
  areaAssignments   UserAreaAssignment[]
  reflections       TeacherDailyReflection[]

  @@index([email])
  @@index([status])
  @@map("persons")
}

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  personId     String    @map("person_id") @db.Char(36)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  status       String    @default("active") @db.VarChar(50)
  lastLoginAt  DateTime? @map("last_login_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  person            Person                   @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessions          Session[]
  schoolMemberships UserSchoolMembership[]
  areaAssignments   UserAreaAssignment[]
  reflections       TeacherDailyReflection[]
  uploadedFiles     EvidenceFile[]           @relation("UserUploadedFile")
  conversations     AiConversation[]
  sarMappingsByUser ReflectionSarMapping[]   @relation("SarMappedByUser")
  tasksCreated      Task[]                   @relation("TaskCreatedByUser")
  taskAssignments   TaskAssignee[]

  @@index([personId])
  @@index([status])
  @@map("users")
}

model Session {
  // Stores SHA-256(hex) of the token. The raw token is only in the cookie.
  id        String   @id @db.VarChar(64)
  userId    String   @map("user_id") @db.Char(36)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(255)
  scopeLevel  String   @map("scope_level") @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  memberships UserSchoolMembership[]

  @@map("roles")
}

// ============================================================
// Tenant
// ============================================================

model EducationAreaOffice {
  id         String   @id @default(uuid()) @db.Char(36)
  code       String   @unique @db.VarChar(100)
  name       String   @db.VarChar(255)
  officeType String?  @map("office_type") @db.VarChar(100)
  province   String?  @db.VarChar(255)
  region     String?  @db.VarChar(255)
  address    String?  @db.Text
  phone      String?  @db.VarChar(50)
  email      String?  @db.VarChar(255)
  settings   Json?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  networks        SchoolNetwork[]
  schools         School[]
  areaAssignments UserAreaAssignment[]

  @@map("education_area_offices")
}

model SchoolNetwork {
  id           String   @id @default(uuid()) @db.Char(36)
  areaOfficeId String   @map("area_office_id") @db.Char(36)
  code         String   @db.VarChar(100)
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  areaOffice EducationAreaOffice @relation(fields: [areaOfficeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  schools    School[]

  @@unique([areaOfficeId, code], name: "uq_school_network_area_code")
  @@index([areaOfficeId])
  @@map("school_networks")
}

model School {
  id              String   @id @default(uuid()) @db.Char(36)
  areaOfficeId    String?  @map("area_office_id") @db.Char(36)
  schoolNetworkId String?  @map("school_network_id") @db.Char(36)
  code            String   @unique @db.VarChar(100)
  name            String   @db.VarChar(255)
  address         String?  @db.Text
  province        String?  @db.VarChar(255)
  district        String?  @db.VarChar(255)
  subdistrict     String?  @db.VarChar(255)
  schoolSize      String?  @map("school_size") @db.VarChar(100)
  schoolType      String?  @map("school_type") @db.VarChar(100)
  settings        Json?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  areaOffice    EducationAreaOffice?     @relation(fields: [areaOfficeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  network       SchoolNetwork?           @relation(fields: [schoolNetworkId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYears AcademicYear[]
  departments   Department[]
  classrooms    Classroom[]
  agents        Agent[]
  memberships   UserSchoolMembership[]
  evidenceFiles EvidenceFile[]
  conversations AiConversation[]
  reflections   TeacherDailyReflection[]
  aiRunLogs     AiRunLog[]
  tasks         Task[]

  @@index([areaOfficeId, schoolNetworkId])
  @@map("schools")
}

model AcademicYear {
  id        String    @id @default(uuid()) @db.Char(36)
  schoolId  String    @map("school_id") @db.Char(36)
  yearLabel String    @map("year_label") @db.VarChar(20)
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  isCurrent Boolean   @default(false) @map("is_current")
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  school        School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  terms         AcademicTerm[]
  classrooms    Classroom[]
  memberships   UserSchoolMembership[]
  reflections   TeacherDailyReflection[]
  evidenceFiles EvidenceFile[]
  tasks         Task[]

  @@unique([schoolId, yearLabel])
  @@index([schoolId, isCurrent])
  @@map("academic_years")
}

model AcademicTerm {
  id             String    @id @default(uuid()) @db.Char(36)
  academicYearId String    @map("academic_year_id") @db.Char(36)
  termNo         Int       @map("term_no") @db.TinyInt
  name           String    @db.VarChar(100)
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  isCurrent      Boolean   @default(false) @map("is_current")
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  academicYear AcademicYear             @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reflections  TeacherDailyReflection[]
  tasks        Task[]

  @@unique([academicYearId, termNo])
  @@index([academicYearId, isCurrent])
  @@map("academic_terms")
}

model Department {
  id           String   @id @default(uuid()) @db.Char(36)
  schoolId     String   @map("school_id") @db.Char(36)
  code         String   @db.VarChar(50)
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  headUserId   String?  @map("head_user_id") @db.Char(36)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  school      School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  agents      Agent[]
  memberships UserSchoolMembership[]
  reflections TeacherDailyReflection[]
  tasks       Task[]

  @@unique([schoolId, code])
  @@map("departments")
}

model Classroom {
  id                    String   @id @default(uuid()) @db.Char(36)
  schoolId              String   @map("school_id") @db.Char(36)
  academicYearId        String   @map("academic_year_id") @db.Char(36)
  level                 String   @db.VarChar(50)
  roomNo                String?  @map("room_no") @db.VarChar(50)
  name                  String   @db.VarChar(255)
  homeroomTeacherUserId String?  @map("homeroom_teacher_user_id") @db.Char(36)
  studentCount          Int?     @map("student_count")
  displayOrder          Int      @default(0) @map("display_order")
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  school        School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear  AcademicYear             @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  memberships   UserSchoolMembership[]
  reflections   TeacherDailyReflection[]
  evidenceFiles EvidenceFile[]
  tasks         Task[]

  @@index([schoolId, academicYearId])
  @@map("classrooms")
}

// ============================================================
// Memberships
// ============================================================

model UserSchoolMembership {
  id             String    @id @default(uuid()) @db.Char(36)
  personId       String    @map("person_id") @db.Char(36)
  userId         String?   @map("user_id") @db.Char(36)
  schoolId       String    @map("school_id") @db.Char(36)
  academicYearId String?   @map("academic_year_id") @db.Char(36)
  departmentId   String?   @map("department_id") @db.Char(36)
  classroomId    String?   @map("classroom_id") @db.Char(36)
  roleId         String    @map("role_id") @db.Char(36)
  positionTitle  String?   @map("position_title") @db.VarChar(255)
  membershipType String    @default("staff") @map("membership_type") @db.VarChar(100)
  status         String    @default("active") @db.VarChar(50)
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  person       Person        @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  classroom    Classroom?    @relation(fields: [classroomId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([personId, schoolId, academicYearId, departmentId, classroomId, roleId], name: "uq_membership_scope")
  @@index([personId, schoolId, academicYearId])
  @@index([schoolId, roleId, status])
  @@index([departmentId])
  @@index([classroomId])
  @@map("user_school_memberships")
}

model UserAreaAssignment {
  id            String    @id @default(uuid()) @db.Char(36)
  personId      String    @map("person_id") @db.Char(36)
  userId        String?   @map("user_id") @db.Char(36)
  areaOfficeId  String    @map("area_office_id") @db.Char(36)
  roleCode      String    @map("role_code") @db.VarChar(100)
  positionTitle String?   @map("position_title") @db.VarChar(255)
  status        String    @default("active") @db.VarChar(50)
  startDate     DateTime? @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  person     Person              @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  areaOffice EducationAreaOffice @relation(fields: [areaOfficeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([personId, areaOfficeId, roleCode], name: "uq_area_assignment_scope")
  @@index([personId, areaOfficeId])
  @@index([areaOfficeId, roleCode, status])
  @@map("user_area_assignments")
}

// ============================================================
// AI Agents
// ============================================================

model Agent {
  id                 String   @id @default(uuid()) @db.Char(36)
  schoolId           String?  @map("school_id") @db.Char(36)
  areaOfficeId       String?  @map("area_office_id") @db.Char(36)
  departmentId       String?  @map("department_id") @db.Char(36)
  scopeLevel         String   @default("school") @map("scope_level") @db.VarChar(50)
  agentType          String   @map("agent_type") @db.VarChar(100)
  gradeLevel         String?  @map("grade_level") @db.VarChar(50)
  name               String   @db.VarChar(255)
  systemPrompt       String   @map("system_prompt") @db.MediumText
  modelProvider      String   @default("anthropic") @map("model_provider") @db.VarChar(100)
  modelName          String   @map("model_name") @db.VarChar(255)
  temperature        Decimal  @default(0.30) @db.Decimal(3, 2)
  maxTokens          Int?     @map("max_tokens")
  monthlyTokenBudget BigInt?  @map("monthly_token_budget")
  status             String   @default("active") @db.VarChar(50)
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  school             School?                @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  department         Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  scopes             AgentScopeAssignment[]
  conversations      AiConversation[]
  runLogs            AiRunLog[]
  reflectionAis      ReflectionAiSummary[]
  sarMappingsByAgent ReflectionSarMapping[] @relation("SarMappedByAgent")
  tasksCreated       Task[]                 @relation("TaskCreatedByAgent")
  taskAssignments    TaskAssignee[]

  @@index([schoolId, agentType, status])
  @@index([schoolId, scopeLevel])
  @@index([areaOfficeId, scopeLevel])
  @@map("agents")
}

model AgentScopeAssignment {
  id              String   @id @default(uuid()) @db.Char(36)
  agentId         String   @map("agent_id") @db.Char(36)
  scopeLevel      String   @map("scope_level") @db.VarChar(50)
  areaOfficeId    String?  @map("area_office_id") @db.Char(36)
  schoolNetworkId String?  @map("school_network_id") @db.Char(36)
  schoolId        String?  @map("school_id") @db.Char(36)
  academicYearId  String?  @map("academic_year_id") @db.Char(36)
  academicTermId  String?  @map("academic_term_id") @db.Char(36)
  departmentId    String?  @map("department_id") @db.Char(36)
  classroomId     String?  @map("classroom_id") @db.Char(36)
  roleDescription String?  @map("role_description") @db.Text
  isPrimary       Boolean  @default(false) @map("is_primary")
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([agentId])
  @@index([schoolId, departmentId, classroomId])
  @@map("agent_scope_assignments")
}

model AiConversation {
  id        String   @id @default(uuid()) @db.Char(36)
  agentId   String   @map("agent_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  schoolId  String?  @map("school_id") @db.Char(36)
  title     String?  @db.VarChar(255)
  taskId    String?  @map("task_id") @db.Char(36)
  status    String   @default("active") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  agent    Agent       @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  school   School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  task     Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  messages AiMessage[]
  runLogs  AiRunLog[]

  @@index([userId, agentId, updatedAt])
  @@index([taskId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid()) @db.Char(36)
  conversationId String   @map("conversation_id") @db.Char(36)
  role           String   @db.VarChar(20) // system | user | assistant | tool
  content        String   @db.MediumText
  attachments    Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiRunLog {
  id                        String   @id @default(uuid()) @db.Char(36)
  conversationId            String?  @map("conversation_id") @db.Char(36)
  agentId                   String   @map("agent_id") @db.Char(36)
  schoolId                  String?  @map("school_id") @db.Char(36)
  modelProvider             String   @map("model_provider") @db.VarChar(100)
  modelName                 String   @map("model_name") @db.VarChar(255)
  promptTokens              Int?     @map("prompt_tokens")
  completionTokens          Int?     @map("completion_tokens")
  totalTokens               Int?     @map("total_tokens")
  promptCacheReadTokens     Int?     @map("prompt_cache_read_tokens")
  promptCacheCreationTokens Int?     @map("prompt_cache_creation_tokens")
  costUsd                   Decimal? @map("cost_usd") @db.Decimal(10, 4)
  latencyMs                 Int?     @map("latency_ms")
  status                    String   @db.VarChar(50)
  errorMessage              String?  @map("error_message") @db.Text
  createdAt                 DateTime @default(now()) @map("created_at") @db.DateTime(3)

  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  agent        Agent           @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  school       School?         @relation(fields: [schoolId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([schoolId, createdAt])
  @@index([agentId, createdAt])
  @@map("ai_run_logs")
}

// ============================================================
// Reflection (Phase 1 core)
// ============================================================

model TeacherDailyReflection {
  id              String    @id @default(uuid()) @db.Char(36)
  schoolId        String    @map("school_id") @db.Char(36)
  areaOfficeId    String?   @map("area_office_id") @db.Char(36)
  schoolNetworkId String?   @map("school_network_id") @db.Char(36)
  academicYearId  String    @map("academic_year_id") @db.Char(36)
  academicTermId  String?   @map("academic_term_id") @db.Char(36)
  departmentId    String?   @map("department_id") @db.Char(36)
  classroomId     String?   @map("classroom_id") @db.Char(36)
  lessonPlanId    String?   @map("lesson_plan_id") @db.Char(36) // Phase 2+
  taskId          String?   @map("task_id") @db.Char(36)
  teacherUserId   String    @map("teacher_user_id") @db.Char(36)
  teacherPersonId String?   @map("teacher_person_id") @db.Char(36)
  reflectionDate  DateTime  @map("reflection_date") @db.Date
  periodNo        Int?      @map("period_no") @db.TinyInt
  subject         String?   @db.VarChar(255)
  topic           String?   @db.VarChar(500)
  whatHappened    String?   @map("what_happened") @db.Text
  whatStudentsDid String?   @map("what_students_did") @db.Text
  successes       String?   @db.Text
  problems        String?   @db.Text
  nextImprovement String?   @map("next_improvement") @db.Text
  summaryShort    String?   @map("summary_short") @db.Text
  aiSummary       String?   @map("ai_summary") @db.MediumText
  aiTags          Json?     @map("ai_tags")
  status          String    @default("draft") @db.VarChar(50)
  isSarCandidate  Boolean   @default(false) @map("is_sar_candidate")
  deletedAt       DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  school        School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear  AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicTerm  AcademicTerm?          @relation(fields: [academicTermId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  department    Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  classroom     Classroom?             @relation(fields: [classroomId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  task          Task?                  @relation(fields: [taskId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teacherUser   User                   @relation(fields: [teacherUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teacherPerson Person?                @relation(fields: [teacherPersonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  attachments   ReflectionAttachment[]
  aiSummaries   ReflectionAiSummary[]
  sarMappings   ReflectionSarMapping[]

  @@index([teacherUserId, reflectionDate])
  @@index([teacherUserId, status])
  @@index([schoolId, academicYearId, reflectionDate])
  @@index([schoolId, status])
  @@index([classroomId, reflectionDate])
  @@index([taskId])
  @@map("teacher_daily_reflections")
}

model ReflectionAttachment {
  id             String   @id @default(uuid()) @db.Char(36)
  reflectionId   String   @map("reflection_id") @db.Char(36)
  evidenceFileId String   @map("evidence_file_id") @db.Char(36)
  displayOrder   Int      @default(0) @map("display_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  reflection   TeacherDailyReflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  evidenceFile EvidenceFile           @relation(fields: [evidenceFileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([reflectionId, evidenceFileId])
  @@index([reflectionId])
  @@map("reflection_attachments")
}

model ReflectionAiSummary {
  id           String   @id @default(uuid()) @db.Char(36)
  reflectionId String   @map("reflection_id") @db.Char(36)
  agentId      String   @map("agent_id") @db.Char(36)
  summaryText  String   @map("summary_text") @db.MediumText
  tags         Json?
  confidence   Decimal? @db.Decimal(3, 2)
  modelName    String   @map("model_name") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  reflection TeacherDailyReflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  agent      Agent                  @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([reflectionId, createdAt])
  @@map("reflection_ai_summaries")
}

model ReflectionSarMapping {
  id               String   @id @default(uuid()) @db.Char(36)
  reflectionId     String   @map("reflection_id") @db.Char(36)
  sarStandardCode  String   @map("sar_standard_code") @db.VarChar(100) // FK to sar_standards added in Phase 5
  sarTopic         String?  @map("sar_topic") @db.VarChar(500)
  evidenceStrength String   @default("medium") @map("evidence_strength") @db.VarChar(50)
  mappedByAgentId  String?  @map("mapped_by_agent_id") @db.Char(36)
  mappedByUserId   String?  @map("mapped_by_user_id") @db.Char(36)
  approved         Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  reflection    TeacherDailyReflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mappedByAgent Agent?                 @relation("SarMappedByAgent", fields: [mappedByAgentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  mappedByUser  User?                  @relation("SarMappedByUser", fields: [mappedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([reflectionId])
  @@index([sarStandardCode])
  @@map("reflection_sar_mappings")
}

// ============================================================
// Evidence
// ============================================================

model EvidenceFile {
  id               String    @id @default(uuid()) @db.Char(36)
  schoolId         String    @map("school_id") @db.Char(36)
  areaOfficeId     String?   @map("area_office_id") @db.Char(36)
  academicYearId   String?   @map("academic_year_id") @db.Char(36)
  academicTermId   String?   @map("academic_term_id") @db.Char(36)
  departmentId     String?   @map("department_id") @db.Char(36)
  classroomId      String?   @map("classroom_id") @db.Char(36)
  taskId           String?   @map("task_id") @db.Char(36)
  fileType         String    @map("file_type") @db.VarChar(50)
  fileUrl          String    @map("file_url") @db.VarChar(1000)
  fileSizeBytes    Int?      @map("file_size_bytes") @db.UnsignedInt
  mimeType         String?   @map("mime_type") @db.VarChar(100)
  title            String?   @db.VarChar(500)
  description      String?   @db.Text
  uploadedByUserId String    @map("uploaded_by_user_id") @db.Char(36)
  tags             Json?
  sarStatus        String?   @map("sar_status") @db.VarChar(50)
  deletedAt        DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  school       School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear AcademicYear?          @relation(fields: [academicYearId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  classroom    Classroom?             @relation(fields: [classroomId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  task         Task?                  @relation(fields: [taskId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  uploadedBy   User                   @relation("UserUploadedFile", fields: [uploadedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attachments  ReflectionAttachment[]

  @@index([schoolId, academicYearId])
  @@index([uploadedByUserId])
  @@index([sarStatus])
  @@index([taskId])
  @@map("evidence_files")
}

// ============================================================
// Cron / Background jobs
// ============================================================

/**
 * Idempotent audit log for scheduled jobs. One row per job execution per
 * (school, date, kind). Lets us:
 * - Avoid double-running on the same day (UNIQUE constraint)
 * - Track delivery latency / coverage over time
 * - Hook in T-131 (email): record per-teacher reminder dispatches
 */
model DailyReminderLog {
  id                String    @id @default(uuid()) @db.Char(36)
  schoolId          String    @map("school_id") @db.Char(36)
  runDate           DateTime  @map("run_date") @db.Date
  jobKind           String    @map("job_kind") @db.VarChar(50) // 'reminder' | 'cleanup_sessions' | ...
  triggeredBy       String    @map("triggered_by") @db.VarChar(50) // 'schedule' | 'manual' | 'test'
  teachersTotal     Int       @default(0) @map("teachers_total")
  teachersMissing   Int       @default(0) @map("teachers_missing")
  notificationsSent Int       @default(0) @map("notifications_sent")
  details           Json?
  startedAt         DateTime  @default(now()) @map("started_at") @db.DateTime(3)
  completedAt       DateTime? @map("completed_at") @db.DateTime(3)
  status            String    @db.VarChar(50) // 'running' | 'success' | 'error'
  errorMessage      String?   @map("error_message") @db.Text

  @@unique([schoolId, runDate, jobKind], name: "uq_reminder_log_school_date_kind")
  @@index([runDate, jobKind])
  @@map("daily_reminder_logs")
}

// ============================================================
// Tasks (Phase 2 — assignment + approval workflow)
// ============================================================

/// Assignment umbrella. Phase 2 starts with status-field-driven workflow;
/// approval_routes + task_outputs tables come in later slices once the chain
/// of approvers is needed (Lesson Plan / SAR Evidence). Reflection / AI
/// conversation / Evidence file all back-link via `task_id` (set null on
/// task delete so historical artifacts survive).
model Task {
  id               String    @id @default(uuid()) @db.Char(36)
  schoolId         String    @map("school_id") @db.Char(36)
  areaOfficeId     String?   @map("area_office_id") @db.Char(36)
  schoolNetworkId  String?   @map("school_network_id") @db.Char(36)
  academicYearId   String    @map("academic_year_id") @db.Char(36)
  academicTermId   String?   @map("academic_term_id") @db.Char(36)
  departmentId     String?   @map("department_id") @db.Char(36)
  classroomId      String?   @map("classroom_id") @db.Char(36)
  taskType         String    @map("task_type") @db.VarChar(100) // lesson_plan/worksheet/plc/sar_evidence/reflection/general/...
  scopeLevel       String    @default("school") @map("scope_level") @db.VarChar(50)
  title            String    @db.VarChar(500)
  description      String?   @db.MediumText
  status           String    @default("draft") @db.VarChar(50)
  priority         String    @default("normal") @db.VarChar(20)
  dueDate          DateTime? @map("due_date") @db.DateTime(3)
  createdByUserId  String    @map("created_by_user_id") @db.Char(36)
  createdByAgentId String?   @map("created_by_agent_id") @db.Char(36)
  parentTaskId     String?   @map("parent_task_id") @db.Char(36)
  metadata         Json?
  deletedAt        DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  school         School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear   AcademicYear             @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicTerm   AcademicTerm?            @relation(fields: [academicTermId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  department     Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  classroom      Classroom?               @relation(fields: [classroomId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdByUser  User                     @relation("TaskCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByAgent Agent?                   @relation("TaskCreatedByAgent", fields: [createdByAgentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  parent         Task?                    @relation("TaskParent", fields: [parentTaskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       Task[]                   @relation("TaskParent")
  assignees      TaskAssignee[]
  reflections    TeacherDailyReflection[]
  conversations  AiConversation[]
  evidenceFiles  EvidenceFile[]

  @@index([schoolId, academicYearId, academicTermId])
  @@index([schoolId, status])
  @@index([departmentId, status])
  @@index([classroomId, status])
  @@index([dueDate, status])
  @@index([parentTaskId])
  @@map("tasks")
}

/// One row per actor assigned to a task. `userId` or `agentId` set (not both
/// in Phase 2 — kept flexible for Command Center AI-driven assignments later).
/// `role` distinguishes responsibility tier: who does the work vs. who reviews
/// vs. who approves. Phase 2 ships with `responsible` + `approver` only;
/// `reviewer` / `observer` exist in the spec but aren't surfaced in UI yet.
model TaskAssignee {
  id        String   @id @default(uuid()) @db.Char(36)
  taskId    String   @map("task_id") @db.Char(36)
  userId    String?  @map("user_id") @db.Char(36)
  agentId   String?  @map("agent_id") @db.Char(36)
  role      String   @default("responsible") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  task  Task   @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([taskId])
  @@index([userId, role])
  @@index([agentId, role])
  @@map("task_assignees")
}
